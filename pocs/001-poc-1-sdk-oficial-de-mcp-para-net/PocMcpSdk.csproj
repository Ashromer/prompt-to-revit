    <RootNamespace>PocMcpSdk</RootNamespace>
    <AssemblyName>PocMcpSdk</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versión exacta fijada por pocs/001-poc-1-sdk-oficial-de-mcp-para-net/DECISION-PELDANO.md §4. No usar rango flotante. -->
