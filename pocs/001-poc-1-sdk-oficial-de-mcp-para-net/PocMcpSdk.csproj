    <!-- Última 8.0.x disponible sin verificar por dotnet restore en esta tarea (no hay Bash en esta sesión); ver informe. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

</Project>
